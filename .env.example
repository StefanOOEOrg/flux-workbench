# Copy to .env and adjust. Real environment variables win over this file.
# The file is read once at startup (see README).

# Render bridge. The default in the code is http://127.0.0.1:8002/generate, which only fits
# a bridge on the same machine. For the GX10:
FLUX_BRIDGE_URL=http://YOUR-BRIDGE-HOST:8002/generate

# Seconds to wait for one render
# FLUX_BRIDGE_TIMEOUT=900

# Folder with one sub-folder per project (default: ./projects)
# FLUX_PROJECTS_DIR=./projects

# LoRA slots (default: ./loras.json; see loras.example.json)
# FLUX_LORA_CONFIG=./loras.json

# Port of the web UI
# FLUX_PORT=8080
